        "x": 0.1,
        "y": 0.5
      },
      "requires": [],
      "unlocks": [
        "train_silence"
      ],
      "story_panels": [
        {
          "text": "They pull you through a service door under the city. Someone is already feeding the Recruiter's badge into a burn bag."
        },
        {
          "text": "A colder voice on the interior radio: \"Ops. Condolences later. Here we teach Influence properly \u2014 silence, discard, denial. Then you earn the right to leave.\""
        }
      ],
      "rewards": {
        "ledger_ids": [
          "file_hq_arrival"
        ]
      },
      "story_panels_reckless": [
        {
          "text": "They pull you through a service door. The Recruiter's badge is already ash. Ops does not mention the drop you skipped."
        },
        {
          "text": "\"Reckless on the street, reckless in my halls. We will work with the kit you kept. Silence. Discard. Denial. Then you leave.\""
        }
      ],
      "coach": "ops"
    },
