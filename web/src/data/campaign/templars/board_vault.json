    {
      "id": "vault_intro",
      "type": "story",
      "title": "The Seal Holds",
      "blurb": "A Chaplain finds you at the side door.",
      "map": {
        "x": 0.12,
        "y": 0.58
      },
      "requires": [],
      "unlocks": [
        "nave_watch"
      ],
      "story_panels": [
        {
          "text": "Candle-smoke and wet stone. A Chaplain in a dark cassock does not ask your name. \"The seal still holds. A heist team is already in the nave.\""
        },
        {
          "text": "\"Faith. Walls. Healing. We script the first lessons so you learn by standing, not by dying at the door.\""
        },
        {
          "text": "They press a thin reliquary deck into your hands. \"Energy. Taunt. Prayer. Follow the prompts.\""
        }
      ],
      "rewards": {
        "ledger_ids": [
          "file_seal"
        ]
      },
      "coach": "chaplain"
    },
