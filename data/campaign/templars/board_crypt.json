      "story_panels": [
        {
          "text": "The Guardian is down. The Chaplain does not celebrate. He takes a lamp and a side door under the nave. Bone dust. Gold in the grout."
        },
        {
          "text": "\"The heist team is still in the ossuary. Recur. Shielding. Charge. We teach you how the dead stand back up. Then you earn the right to leave.\""
        }
      ],
      "story_panels_reckless": [
        {
          "text": "The Guardian is down. The Chaplain does not ask why the vestry was empty. He takes the lamp anyway."
        },
        {
          "text": "\"Proud at the door, proud in my crypt. Recur. Shielding. Charge. Then you leave with the kit you kept.\""
        }
      ],
      "rewards": {
        "ledger_ids": [
          "file_crypt_arrival"
