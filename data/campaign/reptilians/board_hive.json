  "nodes": [
    {
      "id": "hive_intro",
      "type": "story",
      "title": "The Air Goes Wrong",
      "blurb": "A voice sits behind your eyes.",
      "map": { "x": 0.12, "y": 0.58 },
      "requires": [],
      "unlocks": ["comb_watch"],
      "story_panels": [
        { "text": "The vault held. Then the air went wrong. A voice that is not a voice sits behind your eyes. \"The comb is open. You will molt or you will be eaten.\"" },
        { "text": "\"Psionics. Stealth. Static. We script the first lessons so you learn by hiding, not by dying in the dark.\"" },
        { "text": "A thin scaled deck is already in your hands. You do not remember taking it. \"Energy. Rush. Hide. Follow the prompts.\"" }
      ],
      "rewards": { "ledger_ids": ["file_air"] },
      "coach": "voice"
    },
