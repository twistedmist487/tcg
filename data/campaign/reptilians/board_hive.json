            "copies": 1,
            "trim": ["reptilians_char_007", "reptilians_spell_004", "neutral_spell_040"]
          },
          {
            "id": "reptilians_char_007",
            "label": "Dump a Hatchling",
            "blurb": "Cut one Hatchling Brood. Leaner hand for the static.",
            "action": "prune",
            "prune_id": "reptilians_char_007"
          },
          {
            "id": "walk",
            "label": "Keep walking",
            "blurb": "No change. The Voice logs you as proud.",
            "action": "skip"
          }
        ]
      },
