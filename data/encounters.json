    "steps": [
      {
        "id": "welcome",
        "title": "Energy and your hand",
        "text": "You start with 1 energy. Cards cost energy to play. Drag Squire (cost 1) onto your board, or click it then Play Card."
      },
      {
        "id": "exhaustion",
        "title": "Exhausted characters",
        "text": "Most characters cannot attack the turn they are played. Click End Turn and let the Recruiter go. Charge is the exception \u2014 those can attack immediately."
      },
      {
        "id": "attack",
        "title": "Combat",
        "text": "Your character is ready. Drag it onto the highlighted enemy, or click it then the enemy. If nothing is blocking you, drag onto their hero (Attack Face)."
      },
      {
        "id": "deathrattle",
        "title": "Deathrattle",
        "text": "Hatchling Brood died and summoned a Raptor. Deathrattle happens when a character dies \u2014 you still have to deal with the new body."
      },
      {
        "id": "taunt",
        "title": "Taunt",
        "text": "That enemy has Taunt \u2014 you must attack it first. Drag your ready character onto the outlined Taunt, or click it then the Taunt. You cannot hit face until the wall is gone."
      },
      {
        "id": "spell",
        "title": "Spells",
        "text": "Spells are one-shot effects. Drag Divine Smite onto the highlighted enemy, or click it then the enemy you want to damage."
      },
      {
        "id": "location",
        "title": "Locations",
        "text": "Locations stay in play (one at a time). Drag Sacred Chapel onto your location slot, or click it then Play Card."
      },
      {
        "id": "charge",
        "title": "Charge",
        "text": "Zealot has Charge \u2014 it can attack the turn you play it. Drag Zealot onto your board, then drag it onto an enemy. You can also click it, Play Card, then attack."
      },
      {
        "id": "free",
        "title": "Your move",
        "text": "You know the loop: spend energy, attack, end turn. Reduce the Recruiter to 0 life. The Recruiter will keep poking your hero, so do not stall."
      }
    ]
  },
