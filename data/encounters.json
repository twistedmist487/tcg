    "steps": [
      {
        "id": "recycle",
        "title": "Recycle",
        "text": "Burn Bag has Recycle. Drag it onto your deck, or select it and click Recycle \u2014 pay 1 energy, shuffle it into your deck, and draw. You are not playing it."
      },
      {
        "id": "split",
        "title": "Split",
        "text": "Play Forked Brief. Split lets you pick one printed option. Deal 2 damage to the highlighted Hatchling \u2014 killing it is better than drawing here."
      },
      {
        "id": "drain",
        "title": "Drain",
        "text": "Play Leech Contact. Drain heals your hero for the combat damage it deals. Next turn, attack with it."
      },
      {
        "id": "drain-attack",
        "title": "Drain combat",
        "text": "Leech Contact is ready. Attack face or a character \u2014 the damage heals you. That is Drain."
      },
      {
        "id": "ward",
        "title": "Ward",
        "text": "Play Quiet Vest. Ward ignores all damage until the end of this turn and does not pop. It fades when your turn ends."
      },
      {
        "id": "free",
        "title": "Lab complete",
        "text": "Recycle, Split, Drain, and Ward are the new verbs. Finish the Instructor or return to the menu whenever you like."
      }
    ]
  },
